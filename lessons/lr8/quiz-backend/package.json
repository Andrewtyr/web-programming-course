{
  "name": "quiz-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:unit": "vitest run src/services/scoringService.unit.test.ts src/utils/validation.unit.test.ts src/services/sessionService.unit.test.ts",
    "test:feature": "vitest run src/routes/auth.feature.test.ts src/routes/sessions.feature.test.ts src/routes/admin.feature.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.3.1",
    "hono": "^4.12.7",
    "prisma": "^7.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^3.1.0"
  }
}
