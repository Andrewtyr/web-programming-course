# PostgreSQL (локально: порт с хоста; в Docker Compose: host = db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quiz"

# HTTP-порт сервера (по умолчанию в коде 3001 для локального dev с Vite). В docker-compose.yml задано PORT=3000.
# С хоста при Docker Compose: http://localhost:18080 (проброс 18080→3000; см. docker-compose.yml).
# PORT=3001

JWT_SECRET="change-me-min-32-characters-long-secret!!"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# После первой миграции, если пусто: npm run db:seed (или npx prisma db seed) — демо-вопрос для verify:integration
